# SITE_ADDRESS comes from .env. Port 80 must be reachable so Let's Encrypt can issue.
{$SITE_ADDRESS} {
	handle /api/auth-config {
		reverse_proxy web:8081
	}
	handle {
		reverse_proxy web:8080
	}
}

# Same host, same certificate. The reachability test is only on this port.
{$SITE_ADDRESS}:8443 {
	handle /api/* {
		reverse_proxy web:8081
	}
	handle {
		reverse_proxy web:8080
	}
}
