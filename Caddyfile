# Public console. Entra ID sign-in and customer certificate upload.
# Replace example.com. Port 80 must stay open so Let's Encrypt can issue this certificate.
example.com {
	reverse_proxy web:8080
}

# Break-glass local accounts. Same site, separate listener so the firewall can
# refuse the public internet. Prefer binding 8443 to a management address.
:8443 {
	tls internal
	reverse_proxy web:8080
}
